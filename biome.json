{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "public/js/**",
      "scripts/**",
      "!public/js/vendor"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "public/js/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          },
          "style": {
            "useTemplate": "off",
            "useExponentiationOperator": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off"
          }
        }
      }
    }
  ]
}
