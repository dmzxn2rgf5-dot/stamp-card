{
  "name": "stamp-card",
  "version": "1.2.0",
  "description": "Stamp Card – the loyalty card alternative. No app, no subscription, runs free on Cloudflare.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "seed": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "check:clean": "bash scripts/check-clean.sh",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:clean"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
